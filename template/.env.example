# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Local Google Drive sync folder root (Phase 1). Exports land in "$DRIVE_DIR/Idea Pipeline/<idea-id>/".
# Example macOS: ~/Library/CloudStorage/GoogleDrive-you@example.com/My Drive
DRIVE_DIR=

# Home Assistant (optional). HA Cloud remote URL and a long-lived access token.
HA_URL=
HA_TOKEN=

# Claude Code
# Where the claude binary is, if not on PATH.
CLAUDE_BIN=claude

# Safety rails for headless runs. run.sh multiplies these by the stage factor in tools/current.md.
DEFAULT_MAX_BUDGET_USD=5
DEFAULT_MAX_TURNS=40

# Gate threshold for triage budget approval: if the estimated validate+plan budget exceeds this, triage opens gate 00.
TRIAGE_BUDGET_GATE_USD=10
